"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    var wallsPosition = wall.getBoundingClientRect();
    var wallsLeftBound = wall.clientLeft;
    var wallsTopBound = wall.clientTop;
    var xInWall = e.clientX - wallsPosition.x;
    var yInWall = e.clientY - wallsPosition.y;
    var xNew = xInWall - wallsLeftBound - spider.offsetWidth / 2;
    var yNew = yInWall - wallsTopBound - spider.offsetHeight / 2;
    var xMax = wall.clientWidth - spider.offsetWidth;
    var yMax = wall.clientHeight - spider.offsetHeight;
    spider.style.left = Math.max(0, Math.min(xMax, xNew)) + "px";
    spider.style.top = Math.max(0, Math.min(yMax, yNew)) + "px";
});

